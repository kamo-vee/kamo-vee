**Database**
CREATE DATABASE invitation_site;
USE invitation_site;
CREATE TABLE rsvps (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    surname VARCHAR(100) NOT NULL,
    status ENUM('Yes','No','Maybe') NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

