<script>
// Show RSVP form and info box
document.getElementById("showFormBtn").addEventListener("click", function(){
    document.getElementById("rsvpForm").style.display="block";
    document.getElementById("rsvpInfoBox").style.display="block";
    this.style.display="none";
});

// Countdown
const eventDate = new Date("October 19, 2025 16:00:00").getTime();
const countdown = document.getElementById("countdown");
setInterval(() => {
    const now = new Date().getTime();
    const diff = eventDate - now;
    if(diff <= 0){ countdown.innerHTML="🎉 It's Party Time!"; return; }
    const d=Math.floor(diff/(1000*60*60*24));
    const h=Math.floor((diff/(1000*60*60))%24);
    const m=Math.floor((diff/(1000*60))%60);
    countdown.innerHTML=`⏳ ${d} Days ${h} Hours ${m} Minutes to go`;
},1000);

// Make main info box "dance" when clicked
const mainBox = document.getElementById("mainInfoBox");
mainBox.addEventListener("click", () => {
    mainBox.style.animation = "bounce 0.6s";
    mainBox.addEventListener("animationend", () => {
        mainBox.style.animation = "";
    }, {once:true});
});
</script>

